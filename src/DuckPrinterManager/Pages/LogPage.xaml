<UserControl x:Class="DuckPrinterManager.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DuckPrinterManager.Ui">
  <Grid Margin="28,0,28,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- intestazione illustrata -->
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="/Assets/art/log.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" Margin="-4,0,14,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="Log" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Tutto quello che fa l'applicazione, in tempo reale. Doppio clic su una riga di un task per aprirne il log." Style="{StaticResource PageSub}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource QuietBtn}" Click="OnCopy" Margin="0,0,6,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="Copia" Margin="6,0,0,0"/></StackPanel>
        </Button>
        <Button Style="{StaticResource QuietBtn}" Click="OnOpenFile" Margin="0,0,6,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="Apri file" Margin="6,0,0,0"/></StackPanel>
        </Button>
        <Button Style="{StaticResource QuietBtn}" Click="OnClear">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="Pulisci vista" Margin="6,0,0,0"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- contatori -->
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,-12,12">
      <Border Style="{StaticResource StatTile}" Margin="0,0,12,0">
        <Grid>
          <StackPanel>
            <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource Blue}" VerticalAlignment="Center"/><TextBlock Text="Eventi" Style="{StaticResource TxtCaption}" Margin="7,0,0,0"/></StackPanel>
            <TextBlock x:Name="StatAll" Text="0" Style="{StaticResource StatNumber}" Margin="0,4,0,0"/>
          </StackPanel>
          <TextBlock x:Name="TxtLast" Style="{StaticResource TxtCaption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
        </Grid>
      </Border>
      <Border Style="{StaticResource StatTile}" Margin="0,0,12,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource Orange}" VerticalAlignment="Center"/><TextBlock Text="Avvisi" Style="{StaticResource TxtCaption}" Margin="7,0,0,0"/></StackPanel>
          <TextBlock x:Name="StatWarn" Text="0" Style="{StaticResource StatNumber}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatTile}" Margin="0,0,12,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource Red}" VerticalAlignment="Center"/><TextBlock Text="Errori" Style="{StaticResource TxtCaption}" Margin="7,0,0,0"/></StackPanel>
          <TextBlock x:Name="StatErr" Text="0" Style="{StaticResource StatNumber}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- filtri -->
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Border Style="{StaticResource WellBox}" ui:Seg.Slide="True" Padding="3" HorizontalAlignment="Left">
        <StackPanel x:Name="LevelBar" Orientation="Horizontal">
          <RadioButton Style="{StaticResource SegSlideSmall}" Content="Tutto" GroupName="lvl" Tag="all" IsChecked="True" Checked="OnLevel"/>
          <RadioButton Style="{StaticResource SegSlideSmall}" Content="Task" GroupName="lvl" Tag="task" Checked="OnLevel"/>
          <RadioButton Style="{StaticResource SegSlideSmall}" Content="Avvisi ed errori" GroupName="lvl" Tag="warn" Checked="OnLevel"/>
          <RadioButton Style="{StaticResource SegSlideSmall}" Content="Solo errori" GroupName="lvl" Tag="err" Checked="OnLevel"/>
          <RadioButton Style="{StaticResource SegSlideSmall}" Content="Con dettagli" GroupName="lvl" Tag="debug" Checked="OnLevel"/>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBox x:Name="TxtSearch" Style="{StaticResource SearchField}" Width="260" Height="30" Tag="Filtra il testo" TextChanged="OnFilter"/>
        <Border Style="{StaticResource WellBox}" Padding="10,2" Margin="10,0,0,0">
          <CheckBox x:Name="ChkFollow" Style="{StaticResource Switch}" Content="Segui" IsChecked="True"/>
        </Border>
      </StackPanel>
    </Grid>

    <!-- elenco -->
    <Border Grid.Row="3" Style="{StaticResource GroupCard}">
      <Grid>
        <ListView x:Name="LstLog" Style="{StaticResource FlatListView}" ItemContainerStyle="{StaticResource RowListItem}" Padding="8,6"
                  SelectionMode="Extended" FontFamily="{StaticResource FMono}" FontSize="11.5" MouseDoubleClick="OnOpenTask"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListView.ItemTemplate>
            <DataTemplate DataType="{x:Type ui:LogRow}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" ui:Tok.Foreground="{Binding FgKey}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource LabelTertiary}" Width="124"/>
                <TextBlock Text="{Binding Level}" Foreground="{DynamicResource LabelSecondary}" Width="50" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Task}" Foreground="{DynamicResource Purple}" Width="74"/>
                <TextBlock Text="{Binding Msg}" Foreground="{DynamicResource Label}"/>
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <Image Source="/Assets/art/log.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.9"/>
          <TextBlock x:Name="EmptyTitle" Text="Niente da mostrare" Style="{StaticResource TxtTitle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          <TextBlock x:Name="EmptyText" Text="Nessuna riga corrisponde al filtro scelto." Style="{StaticResource TxtMuted}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
