<UserControl x:Class="DuckPrinterManager.Pages.MacAuthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DuckPrinterManager.Ui">
  <Grid Margin="28,0,28,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- intestazione -->
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="/Assets/art/mac_search.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" Margin="-4,0,14,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="MAC Auth" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Cerca un'utenza 802.1X per MAC o nome host: i dati si modificano direttamente nella scheda." Style="{StaticResource PageSub}"/>
      </StackPanel>
      <Button x:Name="BtnNewUser" Grid.Column="2" Style="{StaticResource SoftBtn}" Height="36" VerticalAlignment="Center" Click="OnNewUser">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="Nuova utenza" Margin="7,0,0,0"/></StackPanel>
      </Button>
    </Grid>

    <!-- ricerca grande -->
    <StackPanel x:Name="SearchRow" Grid.Row="1" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="TxtSearch" Style="{StaticResource SearchField}" Height="46" FontSize="15" KeyDown="OnSearchKey"
                 Tag="MAC in qualunque formato (00:11:22:aa:bb:cc) oppure nome host (PR0042)"/>
        <Button x:Name="BtnSearch" Grid.Column="1" Style="{StaticResource PrimaryBtn}" Height="44" Margin="12,0,0,0" Click="OnSearch" Padding="30,0">
          <TextBlock Text="Cerca" FontSize="13.5"/>
        </Button>
      </Grid>
      <Border x:Name="LoginBanner" Style="{StaticResource NoteBox}" Margin="0,10,0,0" Padding="12,8" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
          <TextBlock x:Name="LoginBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Label}"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- risultati -->
    <Grid x:Name="MainArea" Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel x:Name="MultiPanel" Visibility="Collapsed" Margin="0,0,0,12">
        <TextBlock x:Name="MultiText" Style="{StaticResource TxtCaption}" Margin="4,0,0,6" TextWrapping="Wrap"/>
        <ListView x:Name="LstResults" Style="{StaticResource FlatListView}" ItemContainerStyle="{StaticResource CardListItem}" MaxHeight="140" SelectionChanged="OnResultSelected">
          <ListView.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
          <ListView.ItemTemplate>
            <DataTemplate>
              <StackPanel Width="250" Margin="0,0,8,0">
                <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding SamAccountName}" Style="{StaticResource TxtCaption}" FontFamily="{StaticResource FMono}"/>
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>

      <!-- scheda utenza -->
      <Border x:Name="FoundPanel" Grid.Row="1" Style="{StaticResource GroupCard}" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="20,18,20,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="60" Height="60" CornerRadius="16" Background="{DynamicResource BgFieldAlt}" BorderBrush="{DynamicResource SeparatorSoft}" BorderThickness="1">
              <Image Source="/Assets/logo.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="FoundTitle" Style="{StaticResource TxtTitle}" FontSize="22"/>
              <TextBlock x:Name="FoundSub" Style="{StaticResource TxtMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <WrapPanel x:Name="FoundChips" Grid.Column="2" VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Right"/>
          </Grid>
          <Border x:Name="ProbeBox" Grid.Row="1" Style="{StaticResource WellBox}" Margin="20,0,20,10" Padding="12,8">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,120,0">
                <TextBlock x:Name="ProbeGlyph" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0"/>
                <StackPanel>
                  <TextBlock x:Name="ProbeText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="ProbeDetail" Style="{StaticResource TxtCaption}" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
              <Button x:Name="BtnProbe" Style="{StaticResource QuietBtn}" Height="28" HorizontalAlignment="Right" Click="OnProbe"
                      Content="Prova login" ToolTip="Bind LDAP sul DC con utente = MAC e password = MAC"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,8">
            <Grid x:Name="DetailGrid" Margin="20,0,20,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            </Grid>
          </ScrollViewer>
          <!-- zona pericolosa: fissa in fondo alla scheda, sempre visibile anche con molti dettagli -->
          <Border x:Name="DeleteBar" Grid.Row="3" BorderBrush="{DynamicResource SeparatorSoft}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
              <StackPanel VerticalAlignment="Center" Margin="0,0,180,0">
                <TextBlock Text="Elimina utenza" FontWeight="SemiBold" Foreground="{DynamicResource Label}"/>
                <TextBlock Style="{StaticResource TxtCaption}" TextWrapping="Wrap"
                           Text="Toglie l'oggetto da Active Directory: la stampante non potra' piu' autenticarsi con questo MAC."/>
              </StackPanel>
              <Button x:Name="BtnDelete" Style="{StaticResource DangerBtn}" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnDelete">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Red}"/><TextBlock Text="Elimina utenza" Margin="7,0,0,0"/></StackPanel>
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- stato vuoto -->
      <Grid x:Name="InfoPanel" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,16">
          <Image Source="/Assets/art/mac_search.png" Width="130" Height="130" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="InfoTitle" Text="Cerca una stampante" Style="{StaticResource TxtTitle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
          <TextBlock x:Name="InfoNote" Text="Scrivi un MAC address o un nome host qui sopra: se il nome non e' in AD viene risolto via DNS e il MAC letto dalla cache ARP."
                     Style="{StaticResource TxtMuted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="0,4,0,0"/>
          <Button x:Name="BtnCreateMissing" Style="{StaticResource SoftBtn}" Height="34" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" Click="OnCreateMissing">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock x:Name="TxtCreateMissing" Text="Crea l'utenza" Margin="7,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="CONFIGURAZIONE IN USO" Style="{StaticResource GroupHeader}"/>
          <Border Style="{StaticResource GroupCard}">
            <Grid x:Name="InfoGrid" Margin="20,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- accesso richiesto -->
    <Grid x:Name="LoginGate" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent">
      <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,32" MaxWidth="560">
        <StackPanel>
          <Image Source="/Assets/art/lock.png" Width="130" Height="130" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Accedi ad Active Directory" Style="{StaticResource TxtTitle}" FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,0"/>
          <TextBlock Text="Con un account di dominio puoi cercare le utenze delle stampanti. Se l'account ha permessi sulla OU delle stampanti potrai anche modificarle e crearne di nuove; altrimenti la pagina resta in sola lettura."
                     Style="{StaticResource TxtMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <Button x:Name="BtnBannerLogin" Style="{StaticResource PrimaryBtn}" Height="36" Content="Accedi" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="34,0" Click="OnLogin"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
