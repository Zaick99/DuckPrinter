<UserControl x:Class="DuckPrinterManager.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DuckPrinterManager.Ui">
  <UserControl.Resources>
    <!-- campo numerico: 70 px bastano per 4 cifre; l'unita' sta accanto -->
    <Style x:Key="NumField" TargetType="TextBox" BasedOn="{StaticResource HintField}">
      <Setter Property="Width" Value="70"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="Unit" TargetType="TextBlock" BasedOn="{StaticResource TxtCaption}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="28,0,28,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="Impostazioni" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="TxtSaveInfo" Style="{StaticResource PageSub}"/>
      </StackPanel>
      <Border Style="{StaticResource WellBox}" ui:Seg.Slide="True" Padding="3" HorizontalAlignment="Right" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="SecAd" Style="{StaticResource SegSlide}" Content="Active Directory" GroupName="sec" IsChecked="True" Checked="OnSection"/>
          <RadioButton x:Name="SecUsers" Style="{StaticResource SegSlide}" Content="Nuove utenze" GroupName="sec" Checked="OnSection"/>
          <RadioButton x:Name="SecDeploy" Style="{StaticResource SegSlide}" Content="Deploy" GroupName="sec" Checked="OnSection"/>
          <RadioButton x:Name="SecProc" Style="{StaticResource SegSlide}" Content="Procedura" GroupName="sec" Checked="OnSection"/>
          <RadioButton x:Name="SecSys" Style="{StaticResource SegSlide}" Content="Task e sistema" GroupName="sec" Checked="OnSection"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- intestazione illustrata della sezione -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Image x:Name="SectionArt" Source="/Assets/art/server.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel x:Name="SectionText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="SectionTitle" Style="{StaticResource TxtTitle}" FontSize="18"/>
          <TextBlock x:Name="SectionSub" Style="{StaticResource TxtMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ClipToBounds="True">
      <!-- ================= ACTIVE DIRECTORY ================= -->
      <Grid x:Name="PanelAd">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="DOMINIO" Style="{StaticResource GroupHeader}"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel>
              <Grid Style="{StaticResource FormRow}">
                <TextBlock Text="Dominio" Style="{StaticResource RowLabel}"/>
                <TextBox x:Name="TxtDomain" Style="{StaticResource HintField}" Width="240" HorizontalAlignment="Right" Tag="example.local"/>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <StackPanel Margin="14,10">
                <TextBlock Text="OU delle stampanti" Style="{StaticResource RowLabel}"/>
                <TextBox x:Name="TxtOu" Style="{StaticResource HintMono}" Margin="0,6,0,0" FontSize="11.5" Tag="OU=Printers,...,DC=example,DC=local"/>
              </StackPanel>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Domain controller" Style="{StaticResource RowLabel}"/>
                <ComboBox x:Name="CmbDc" Grid.Column="1" Style="{StaticResource Combo}"/>
                <Button x:Name="BtnDcs" Grid.Column="2" Style="{StaticResource GhostBtn}" Content="Elenca" Margin="6,0,0,0" Click="OnListDcs"/>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="Usare sempre lo stesso DC evita di rileggere un oggetto appena modificato prima che la replica arrivi agli altri." Style="{StaticResource GroupFooter}"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="REPARTI" Style="{StaticResource GroupHeader}"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel>
              <StackPanel Margin="14,10">
                <TextBlock Text="File elenco reparti" Style="{StaticResource RowLabel}"/>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="TxtReparti" Style="{StaticResource HintMono}" FontSize="11.5" Tag="\\server\share\reparti.txt"/>
                  <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Content="Sfoglia" Margin="6,0,0,0" Click="OnBrowseReparti"/>
                  <Button x:Name="BtnReloadReparti" Grid.Column="2" Style="{StaticResource GhostBtn}" Content="Ricarica" Click="OnReloadReparti"/>
                </Grid>
                <TextBlock x:Name="TxtRepartiInfo" Style="{StaticResource RowHint}" Margin="0,6,0,0"/>
              </StackPanel>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}"><CheckBox x:Name="ChkStrict" Style="{StaticResource Switch}" Content="Accetta solo reparti presenti nell'elenco" VerticalAlignment="Center"/></Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="VERIFICHE" Style="{StaticResource GroupHeader}" Margin="14,18,0,6"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel>
              <Grid Style="{StaticResource FormRow}"><CheckBox x:Name="ChkProbe" Style="{StaticResource Switch}" Content="Prova di login automatica (password = MAC)" VerticalAlignment="Center"/></Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}"><CheckBox x:Name="ChkForceWrite" Style="{StaticResource Switch}" Content="Consenti modifica anche se i permessi non vengono rilevati" VerticalAlignment="Center"/></Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="La prova di login non parte mai se l'utenza e' a un tentativo dalla soglia di blocco." Style="{StaticResource GroupFooter}"/>
        </StackPanel>
      </Grid>

      <!-- ================= NUOVE UTENZE ================= -->
      <Grid x:Name="PanelUsers" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="NOME" Style="{StaticResource GroupHeader}"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel>
              <Grid Style="{StaticResource FormRow}">
                <TextBlock Text="Schema" Style="{StaticResource RowLabel}"/>
                <TextBox x:Name="TxtPattern" Style="{StaticResource HintMono}" Width="220" HorizontalAlignment="Right" Tag="PR{INCREMENTAL}" TextChanged="OnPatternChanged"
                         ToolTip="Testo fisso + {INCREMENTAL}. Con {INCREMENTAL:5} si fissano le cifre."/>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}">
                <TextBlock Text="Cifre del contatore (default)" Style="{StaticResource RowLabel}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBox x:Name="TxtDigits" Style="{StaticResource NumField}" Width="56" TextChanged="OnPatternChanged"/>
                  <TextBlock Text="cifre" Style="{StaticResource Unit}"/>
                </StackPanel>
              </Grid>
              <Border Background="{DynamicResource BgFieldAlt}" BorderBrush="{DynamicResource SeparatorSoft}" BorderThickness="0,1,0,0" Padding="14,10">
                <TextBlock x:Name="TxtPatternPreview" Style="{StaticResource RowHint}"/>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Text="PASSWORD" Style="{StaticResource GroupHeader}" Margin="14,18,0,6"/>
          <Border Style="{StaticResource GroupCard}">
            <Grid Style="{StaticResource FormRow}">
              <TextBlock Text="Password temporanea" Style="{StaticResource RowLabel}"/>
              <PasswordBox x:Name="TxtTempPwd" Style="{StaticResource PwdField}" Width="220" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <TextBlock Text="Serve solo a superare i criteri di complessita' alla creazione: subito dopo la password diventa il MAC. Salvata cifrata (DPAPI)." Style="{StaticResource GroupFooter}"/>
        </StackPanel>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="GRUPPI ASSEGNATI ALLA CREAZIONE" Style="{StaticResource GroupHeader}"/>
          <Border Grid.Row="1" Style="{StaticResource GroupCard}" VerticalAlignment="Top">
            <StackPanel>
              <ListBox x:Name="LstGroups" BorderThickness="0" Background="Transparent" MaxHeight="230"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource SeparatorSoft}" BorderThickness="0,0,0,1" Margin="14,0,0,0">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Height="38">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource IconTile}" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource Indigo}">
                          <TextBlock Text="&#xE716;" Style="{StaticResource TileGlyph}" FontSize="11"/>
                        </Border>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Label}" VerticalAlignment="Center"/>
                      </StackPanel>
                      <Button Style="{StaticResource Toolbtn}" HorizontalAlignment="Right" Margin="0,0,8,0" ToolTip="Rimuovi" Click="OnRemoveGroupItem">
                        <TextBlock Text="&#xE738;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Red}"/>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Margin="14,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TxtGroup" Style="{StaticResource HintField}" Tag="nome del gruppo (o parte, poi Cerca)"/>
                <Button Grid.Column="1" Style="{StaticResource SoftBtn}" Height="30" Margin="6,0,0,0" Click="OnAddGroup" ToolTip="Aggiungi">
                  <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/>
                </Button>
                <Button x:Name="BtnFindGroup" Grid.Column="2" Style="{StaticResource QuietBtn}" Height="30" Margin="6,0,0,0" Content="Cerca in AD" Click="OnFindGroup"/>
              </Grid>
              <ListBox x:Name="LstGroupResults" Style="{StaticResource WellList}" MaxHeight="150" Margin="14,0,14,10" Visibility="Collapsed"
                       MouseDoubleClick="OnPickGroup" ToolTip="Doppio clic per aggiungere"/>
            </StackPanel>
          </Border>
          <TextBlock Grid.Row="2" Text="Ogni nuova utenza viene aggiunta a questi gruppi; l'esito e' riportato gruppo per gruppo." Style="{StaticResource GroupFooter}"/>
        </Grid>
      </Grid>

      <!-- ================= DEPLOY ================= -->
      <Grid x:Name="PanelDeploy" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="ESECUZIONE" Style="{StaticResource GroupHeader}"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel>
              <Grid Style="{StaticResource FormRow}"><CheckBox x:Name="ChkCache" Style="{StaticResource Switch}" Content="Copia i driver nella cache locale" VerticalAlignment="Center"/></Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}"><CheckBox x:Name="ChkAdCreds" Style="{StaticResource Switch}" Content="Prova prima con l'account AD della sessione (poi l'utente Windows)" VerticalAlignment="Center"/></Grid>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource GroupFooter}" Text="Con la cache il task sopravvive a share o chiavette non piu' disponibili. Se un account riceve 'accesso negato' si prova l'altro: serve un amministratore locale dei PC."/>
          <Button Style="{StaticResource GhostBtn}" Content="Svuota cache driver" HorizontalAlignment="Left" Margin="8,6,0,0" Click="OnPruneCache"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="SET_PRT" Style="{StaticResource GroupHeader}"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel>
              <StackPanel Margin="14,10">
                <TextBlock Text="Cartelle (una per riga, tutte le versioni vengono aggiornate)" Style="{StaticResource RowLabel}"/>
                <TextBox x:Name="TxtSetPrtPaths" Style="{StaticResource HintArea}" Height="64" Margin="0,6,0,0" Tag="C:\set_prt"/>
              </StackPanel>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}">
                <TextBlock Text="Batch da rilanciare" Style="{StaticResource RowLabel}"/>
                <TextBox x:Name="TxtSetPrtBat" Style="{StaticResource HintMono}" Width="180" HorizontalAlignment="Right" Tag="set_prt.bat"/>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}">
                <TextBlock Text="Processo da chiudere prima" Style="{StaticResource RowLabel}"/>
                <TextBox x:Name="TxtSetPrtProc" Style="{StaticResource HintMono}" Width="180" HorizontalAlignment="Right" Tag="set_prt_agent"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="PC REMOTI" Style="{StaticResource GroupHeader}" Margin="14,18,0,6"/>
          <Border Style="{StaticResource GroupCard}">
            <Grid Style="{StaticResource FormRow}">
              <TextBlock Text="Cartella di lavoro" Style="{StaticResource RowLabel}"/>
              <TextBox x:Name="TxtRemoteDir" Style="{StaticResource HintMono}" Width="260" HorizontalAlignment="Right" Tag="C:\ProgramData\DuckPM"/>
            </Grid>
          </Border>
          <TextBlock Text="Ci vengono copiati driver e script del task; viene ripulita al termine." Style="{StaticResource GroupFooter}"/>
        </StackPanel>
      </Grid>

      <!-- ================= PROCEDURA: valori di partenza del wizard ================= -->
      <Grid x:Name="PanelProc" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="INSTALLAZIONE" Style="{StaticResource GroupHeader}"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel>
              <Grid Style="{StaticResource FormRow}">
                <TextBlock Text="Nome della stampante" Style="{StaticResource RowLabel}"/>
                <TextBox x:Name="TxtNameTpl" Style="{StaticResource HintMono}" Width="240" HorizontalAlignment="Right" Tag="{}{DRIVERNAME}"/>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}">
                <TextBlock Text="Predefinita via" Style="{StaticResource RowLabel}"/>
                <ComboBox x:Name="CmbDefault" Style="{StaticResource Combo}" Width="240" HorizontalAlignment="Right" DisplayMemberPath="Label" SelectedValuePath="Key"/>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}">
                <TextBlock Text="Prima di installare togli" Style="{StaticResource RowLabel}"/>
                <ComboBox x:Name="CmbPreRemove" Style="{StaticResource Combo}" Width="240" HorizontalAlignment="Right" SelectedValuePath="Tag">
                  <ComboBoxItem Content="Niente" Tag="none"/>
                  <ComboBoxItem Content="La stampante sulla stessa porta" Tag="same"/>
                  <ComboBoxItem Content="Tutte le stampanti di rete" Tag="all"/>
                </ComboBox>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}"><CheckBox x:Name="ChkSetPrtDefault" Style="{StaticResource Switch}" Content="Rilancia set_prt al termine" VerticalAlignment="Center"/></Grid>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource GroupFooter}" Text="Sono i valori con cui si apre la procedura: a ogni deploy si possono cambiare. Si ripristinano con 'Nuova procedura'."/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="RIMOZIONE" Style="{StaticResource GroupHeader}"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel>
              <Grid Style="{StaticResource FormRow}"><CheckBox x:Name="ChkRemovePortsDefault" Style="{StaticResource Switch}" Content="Togli anche le porte non piu' usate" VerticalAlignment="Center"/></Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}"><CheckBox x:Name="ChkRemoveSetPrtDefault" Style="{StaticResource Switch}" Content="Rilancia set_prt al termine" VerticalAlignment="Center"/></Grid>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource GroupFooter}" Text="'Togli TUTTE le stampanti di rete' parte sempre spento: va scelto ogni volta."/>

          <TextBlock Text="QUANDO" Style="{StaticResource GroupHeader}" Margin="14,18,0,6"/>
          <Border Style="{StaticResource GroupCard}">
            <Grid Style="{StaticResource FormRow}">
              <TextBlock Text="Avvio dei task" Style="{StaticResource RowLabel}"/>
              <ComboBox x:Name="CmbStartDefault" Style="{StaticResource Combo}" Width="200" HorizontalAlignment="Right" SelectedValuePath="Tag">
                <ComboBoxItem Content="Subito" Tag="0"/>
                <ComboBoxItem Content="Tra 30 minuti" Tag="1"/>
                <ComboBoxItem Content="Tra 1 ora" Tag="2"/>
                <ComboBoxItem Content="Stasera alle 20:00" Tag="3"/>
                <ComboBoxItem Content="Domani alle 07:00" Tag="4"/>
              </ComboBox>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ================= TASK E SISTEMA ================= -->
      <Grid x:Name="PanelSys" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="SCHEDULER" Style="{StaticResource GroupHeader}"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel>
              <Grid Style="{StaticResource FormRow}" MinHeight="40">
                <TextBlock Text="Task in parallelo" Style="{StaticResource RowLabel}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="TxtParallel" Style="{StaticResource NumField}"/><TextBlock Text="PC" Style="{StaticResource Unit}"/></StackPanel>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}" MinHeight="40">
                <TextBlock Text="Ricontrollo dei PC spenti" Style="{StaticResource RowLabel}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="TxtCheckMin" Style="{StaticResource NumField}"/><TextBlock Text="min" Style="{StaticResource Unit}"/></StackPanel>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}" MinHeight="40">
                <TextBlock Text="Scadenza dei task (0 = mai)" Style="{StaticResource RowLabel}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="TxtMaxAge" Style="{StaticResource NumField}"/><TextBlock Text="ore" Style="{StaticResource Unit}"/></StackPanel>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}" MinHeight="40">
                <TextBlock Text="Dopo un errore riprova fra" Style="{StaticResource RowLabel}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="TxtBackoffBase" Style="{StaticResource NumField}"/><TextBlock Text="min" Style="{StaticResource Unit}"/></StackPanel>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}" MinHeight="40">
                <TextBlock Text="Attesa massima fra i tentativi" Style="{StaticResource RowLabel}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="TxtBackoffMax" Style="{StaticResource NumField}"/><TextBlock Text="min" Style="{StaticResource Unit}"/></StackPanel>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}" MinHeight="40">
                <TextBlock Text="Timeout operazione remota" Style="{StaticResource RowLabel}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="TxtTimeout" Style="{StaticResource NumField}"/><TextBlock Text="s" Style="{StaticResource Unit}"/></StackPanel>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}" MinHeight="40">
                <TextBlock Text="Timeout ping" Style="{StaticResource RowLabel}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="TxtPing" Style="{StaticResource NumField}"/><TextBlock Text="ms" Style="{StaticResource Unit}"/></StackPanel>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}" MinHeight="40"><CheckBox x:Name="ChkTcp" Style="{StaticResource Switch}" Content="Se l'ICMP e' bloccato prova SMB/WinRM/RPC" VerticalAlignment="Center"/></Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}" MinHeight="40"><CheckBox x:Name="ChkAutoStart" Style="{StaticResource Switch}" Content="Avvia lo scheduler all'apertura" VerticalAlignment="Center"/></Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="ASPETTO" Style="{StaticResource GroupHeader}"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel>
              <Grid Style="{StaticResource FormRow}">
                <TextBlock Text="Tema" Style="{StaticResource RowLabel}"/>
                <Border Style="{StaticResource WellBox}" ui:Seg.Slide="True" Padding="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource SegSlideSmall}" Content="Sistema" GroupName="theme" Checked="OnThemePick"/>
                    <RadioButton x:Name="ThemeLight" Style="{StaticResource SegSlideSmall}" Content="Chiaro" GroupName="theme" Checked="OnThemePick"/>
                    <RadioButton x:Name="ThemeDark" Style="{StaticResource SegSlideSmall}" Content="Scuro" GroupName="theme" Checked="OnThemePick"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}"><CheckBox x:Name="ChkDucks" Style="{StaticResource Switch}" Content="Paperelle in movimento sullo sfondo" VerticalAlignment="Center"/></Grid>
              <Rectangle Style="{StaticResource RowSep}"/>
              <Grid Style="{StaticResource FormRow}"><CheckBox x:Name="ChkTranslucent" Style="{StaticResource Switch}" Content="Finestra semitrasparente (vetro, con sfocatura)" VerticalAlignment="Center" Click="OnTranslucentClick"/></Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="POWERSHELL" Style="{StaticResource GroupHeader}" Margin="14,18,0,6"/>
          <Border Style="{StaticResource GroupCard}">
            <StackPanel Margin="14,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TxtPs" Style="{StaticResource HintMono}" FontSize="11.5" Tag="automatico: pwsh 7 se presente, altrimenti Windows PowerShell"/>
                <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Content="Sfoglia" Margin="6,0,0,0" Click="OnBrowsePs"/>
              </Grid>
              <TextBlock x:Name="TxtSysInfo" Style="{StaticResource RowHint}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource GhostBtn}" Content="Apri la cartella dei dati" HorizontalAlignment="Left" Margin="8,8,0,0" Click="OnOpenData"/>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource QuietBtn}" Content="Annulla modifiche" Margin="0,0,8,0" Click="OnRevert"/>
        <Button Style="{StaticResource PrimaryBtn}" Height="34" Content="Salva impostazioni" Click="OnSave"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
