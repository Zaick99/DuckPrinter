<Window x:Class="DuckPrinterManager.Dialogs.DuckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource FText}" FontSize="12.5">
  <Border x:Name="Root" Margin="18" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource Separator}"
          BorderThickness="1" CornerRadius="{StaticResource RPanel}" Opacity="0" MinWidth="380" MaxWidth="620">
    <Border.RenderTransform>
      <TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup>
    </Border.RenderTransform>
    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.35" Color="Black"/>
    </Border.Effect>
    <Grid Margin="22,18,22,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Border x:Name="IconBox" Width="28" Height="28" CornerRadius="14" Style="{DynamicResource ChipOrange}" Padding="0">
          <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" HorizontalAlignment="Center" FontSize="13"/>
        </Border>
        <TextBlock x:Name="TitleText" Style="{StaticResource TxtSub}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="BodyText" Style="{StaticResource ReadOnlyValue}" Foreground="{DynamicResource LabelSecondary}"/>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button x:Name="BtnCancel" Style="{StaticResource QuietBtn}" Content="Annulla" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
        <Button x:Name="BtnOk" Style="{StaticResource PrimaryBtn}" Content="OK" IsDefault="True" Click="OnOk"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
