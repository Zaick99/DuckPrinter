<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DuckPrinterManager</RootNamespace>
    <AssemblyName>DuckPrinterManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\duck.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>Duck Printer Manager</Product>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DuckPrinterManager.Core\DuckPrinterManager.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Theme\tokens.extended.json" LogicalName="Theme.tokens.extended.json" />
    <Resource Include="Assets\duck.png" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\art\*.png" />
    <Resource Include="Assets\nav\*.png" />
    <Resource Include="Assets\avatars\*.png" />
    <Resource Include="Assets\duck.ico" />
  </ItemGroup>
  <!-- libreria Rust: compilata da build.ps1 con cargo in modalita release -->
  <ItemGroup>
    <None Include="..\..\native\duck_core\target\release\duck_core.dll" Condition="Exists('..\..\native\duck_core\target\release\duck_core.dll')" Link="duck_core.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\duck_core\target\x86_64-pc-windows-msvc\release\duck_core.dll" Condition="Exists('..\..\native\duck_core\target\x86_64-pc-windows-msvc\release\duck_core.dll')" Link="duck_core.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\duck_core\target\x86_64-pc-windows-gnu\release\duck_core.dll" Condition="Exists('..\..\native\duck_core\target\x86_64-pc-windows-gnu\release\duck_core.dll')" Link="duck_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
